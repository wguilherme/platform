# ── Obrigatório ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_        # scope: repo — usado em: flux-bootstrap, kind-secrets (github-token)
TUNNEL_TOKEN=eyJ         # Cloudflare Dashboard → Zero Trust → Tunnels → token — usado em: kind-secrets (tunnel-token)

# ── Kubeconfig ────────────────────────────────────────────────────────────────
# Kind/k3d: gerado por `make kind-up` ou `make k3d-up` neste path
# RPi:      gerado pelo Ansible neste path — ajustar antes de rodar as automações
KUBECONFIG_PLATFORM=$(HOME)/.kube/local/platform/config.platform  # usado em: todos os make kubectl/flux

# ── Opcionais (têm default nos .mk) ──────────────────────────────────────────
CLUSTER_NAME=homelab-v8
GITHUB_USER=wguilherme   # usado em: flux-bootstrap
GITHUB_REPO=platform     # usado em: flux-bootstrap
GITHUB_BRANCH=main       # usado em: flux-bootstrap

# ── Portas locais ─────────────────────────────────────────────────────────────
ZOT_LOCAL_PORT=5000
GO_HELLO_PORT=8082
BUN_HELLO_PORT=8083
PYTHON_HELLO_PORT=8084
